+      const char *fit_mode = std::getenv("D2S_MOONLIGHT_FIT_MODE");
+      const bool stretch = fit_mode && std::strcmp(fit_mode, "stretch") == 0;
+      const bool cover = fit_mode && std::strcmp(fit_mode, "cover") == 0;
