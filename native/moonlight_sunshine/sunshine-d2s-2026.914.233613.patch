+/**
+ * @brief Exercise the actual bridge with a coalesced handshake/AU and a fragmented next AU.
+ */
+TEST(D2SBridgeTransport, PreservesCoalescedAndFragmentedAccessUnits) {
+  namespace asio = boost::asio;
+  using tcp = asio::ip::tcp;
+  asio::io_context io;
+  tcp::acceptor listener(io, tcp::endpoint(asio::ip::make_address("127.0.0.1"), 0));
+  tcp::socket peer(io);
+  const std::array<std::pair<const char *, std::string>, 8> environment {{
+    {"D2S_MOONLIGHT_BRIDGE_PORT", std::to_string(listener.local_endpoint().port())},
+    {"D2S_MOONLIGHT_BRIDGE_TOKEN", std::string(64, 'a')},
+    {"D2S_MOONLIGHT_SOURCE_WIDTH", "1920"},
+    {"D2S_MOONLIGHT_SOURCE_HEIGHT", "1080"},
+    {"D2S_MOONLIGHT_SOURCE_LEFT", "0"},
+    {"D2S_MOONLIGHT_SOURCE_TOP", "0"},
+    {"D2S_MOONLIGHT_DESKTOP_WIDTH", "1920"},
+    {"D2S_MOONLIGHT_DESKTOP_HEIGHT", "1080"},
+  }};
+  const auto set_environment = [](const char *name, const char *value) {
+#ifdef _WIN32
+    _putenv_s(name, value ? value : "");
+#else
+    if (value) {
+      setenv(name, value, 1);
+    } else {
+      unsetenv(name);
+    }
+#endif
+  };
+  std::array<std::optional<std::string>, environment.size()> previous;
+  for (std::size_t i = 0; i < environment.size(); ++i) {
+    if (const auto *value = std::getenv(environment[i].first)) {
+      previous[i] = value;
+    }
+    set_environment(environment[i].first, environment[i].second.c_str());
+  }
+  const auto original_mail = mail::man;
+  mail::man = std::make_shared<safe::mail_raw_t>();
+  auto restore = util::fail_guard([&]() {
+    mail::man = original_mail;
+    for (std::size_t i = 0; i < environment.size(); ++i) {
+      set_environment(environment[i].first, previous[i] ? previous[i]->c_str() : nullptr);
+    }
+  });
+  auto local_mail = std::make_shared<safe::mail_raw_t>();
+  auto shutdown = local_mail->event<bool>(mail::shutdown);
+  auto packets = mail::man->queue<video::packet_t>(mail::video_packets);
+  video::config_t config {};
+  config.width = 1280;
+  config.height = 720;
+  config.framerate = 60;
+  config.bitrate = 20000;
+  int channel_marker = 0;
+  std::thread receiver([&]() {
+    video::capture(local_mail, config, &channel_marker);
+  });
+  auto stop = util::fail_guard([&]() {
+    shutdown->raise(true);
+    boost::system::error_code ignored;
+    peer.shutdown(tcp::socket::shutdown_both, ignored);
+    peer.close(ignored);
+    receiver.join();
+  });
+  listener.accept(peer);
+  asio::streambuf hello;
+  asio::read_until(peer, hello, '\n');
+
+  const auto make_record = [](uint64_t index, const std::vector<uint8_t> &payload, bool idr) {
+    std::string record = "D2SF";
+    const auto append_integer = [&](uint64_t value, int bytes) {
+      for (int i = bytes - 1; i >= 0; --i) {
+        record.push_back(static_cast<char>((value >> (i * 8)) & 0xff));
+      }
+    };
+    append_integer(index, 8);
+    append_integer(123456789, 8);
+    append_integer(idr ? 1 : 0, 4);
+    append_integer(payload.size(), 4);
+    record.append(reinterpret_cast<const char *>(payload.data()), payload.size());
+    return record;
+  };
+  const std::vector<uint8_t> first {0, 0, 0, 1, 0x65, 1, 2, 3};
+  const auto coalesced = std::string("{\"ok\":true}\n") + make_record(7, first, true);
+  asio::write(peer, asio::buffer(coalesced));
+  auto packet = packets->pop(2s);
+  ASSERT_TRUE(packet);
+  EXPECT_EQ(packet->frame_index(), 7);
+  EXPECT_TRUE(packet->is_idr());
+  EXPECT_EQ(packet->channel_data, &channel_marker);
+  ASSERT_EQ(packet->data_size(), first.size());
+  EXPECT_EQ(std::memcmp(packet->data(), first.data(), first.size()), 0);
+
+  const std::vector<uint8_t> second(300000, 0x42);
+  const auto fragmented = make_record(8, second, false);
+  asio::write(peer, asio::buffer(fragmented.data(), 12));
+  std::this_thread::sleep_for(2ms);
+  asio::write(peer, asio::buffer(fragmented.data() + 12, fragmented.size() - 12));
+  packet = packets->pop(2s);
+  ASSERT_TRUE(packet);
+  EXPECT_EQ(packet->frame_index(), 8);
+  EXPECT_FALSE(packet->is_idr());
+  ASSERT_EQ(packet->data_size(), second.size());
+  EXPECT_EQ(std::memcmp(packet->data(), second.data(), second.size()), 0);
+}
