+        {"token", token},
+        {"width", config.width},
+        {"height", config.height},
+        {"fps_x100", config.framerateX100 > 0 ? config.framerateX100 : config.framerate * 100},
+        {"bitrate_kbps", config.bitrate},
+        {"codec", config.videoFormat == 0 ? "h264" : config.videoFormat == 1 ? "hevc" : "unsupported"},
+        {"source_width", source_width},
+        {"source_height", source_height},
+        {"source_left", source_left},
+        {"source_top", source_top},
+        {"desktop_width", desktop_width},
+        {"desktop_height", desktop_height},
+        {"dynamic_range", config.dynamicRange}
+      };
+      const auto hello_line = hello.dump() + "\n";
+      asio::write(socket, asio::buffer(hello_line));
+
+      asio::streambuf response;
+      asio::read_until(socket, response, '\n');
+      std::istream response_stream(&response);
+      std::string response_line;
+      std::getline(response_stream, response_line);
+      auto ready = nlohmann::json::parse(response_line);
