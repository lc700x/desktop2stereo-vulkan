+/**
+ * @brief Full-SBS input maps both letterboxed eyes to the same physical desktop point.
+ */
+TEST(D2SStereoInput, FullSbsContainAndBars) {
+  input::touch_port_t port {};
+  port.offset_x = -1920;
+  port.offset_y = 120;
+  port.scalar_tpcoords = 1.0f;
+  port.input_regions = {{{0, 270, 960, 810, 0, 0, 1920, 1080}, {960, 270, 1920, 810, 0, 0, 1920, 1080}}};
+  for (float x : {480.0f, 1440.0f}) {
+    const auto [px, py] = port.map_stereo_input(x, 540);
+    EXPECT_FLOAT_EQ(px, -960);
+    EXPECT_FLOAT_EQ(py, 660);
+    EXPECT_FLOAT_EQ(port.map_stereo_input(x, 0).second, 120);
+    EXPECT_FLOAT_EQ(port.map_stereo_input(x, 1080).second, 1200);
+  }
+  // The dividing line belongs to the right eye, not the far edge of the left eye.
+  EXPECT_FLOAT_EQ(port.map_stereo_input(960, 540).first, -1920);
+}
+
+/**
