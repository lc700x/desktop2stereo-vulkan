+
+      BOOST_LOG(info) << "Moonlight D2S encoded-frame bridge connected "sv
+                      << config.width << "x"sv << config.height << "@"sv
+                      << static_cast<float>(config.framerateX100 > 0 ? config.framerateX100 : config.framerate * 100) / 100.0f
+                      << " codec="sv << hello["codec"];
+
+      auto read_u32 = [](const char *data) {
+        return (static_cast<uint32_t>(static_cast<unsigned char>(data[0])) << 24)
+          | (static_cast<uint32_t>(static_cast<unsigned char>(data[1])) << 16)
+          | (static_cast<uint32_t>(static_cast<unsigned char>(data[2])) << 8)
+          | static_cast<uint32_t>(static_cast<unsigned char>(data[3]));
+      };
+      auto read_u64 = [](const char *data) {
+        uint64_t value = 0;
+        for (int i = 0; i < 8; ++i) {
+          value = (value << 8) | static_cast<unsigned char>(data[i]);
+        }
+        return value;
+      };
+      auto write_command = [&](char command) {
+        asio::write(socket, asio::buffer(&command, sizeof(command)));
+      };
+
+      socket.non_blocking(true);
+      std::vector<char> pending;
+      pending.reserve(1024 * 1024);
+      std::array<char, 256 * 1024> receive_buffer {};
+      constexpr std::size_t HEADER_SIZE = 28;
+      constexpr uint32_t MAX_ACCESS_UNIT_SIZE = 32 * 1024 * 1024;
+
+      while (!shutdown_event->peek()) {
+        if (idr_events->peek()) {
+          idr_events->pop(0ms);
+          write_command('I');
+        }
+        while (invalidation_events->peek()) {
+          if (invalidation_events->pop(0ms)) {
+            write_command('I');
+          }
+        }
+
+        boost::system::error_code socket_error;
+        const auto received = socket.read_some(asio::buffer(receive_buffer), socket_error);
+        if (socket_error == asio::error::would_block || socket_error == asio::error::try_again) {
+          std::this_thread::sleep_for(1ms);
+          continue;
+        }
+        if (socket_error == asio::error::eof) {
+          break;
+        }
+        if (socket_error) {
+          throw boost::system::system_error(socket_error);
+        }
+        pending.insert(pending.end(), receive_buffer.begin(), receive_buffer.begin() + received);
+
+        std::size_t consumed = 0;
+        while (pending.size() - consumed >= HEADER_SIZE) {
+          const auto *record = pending.data() + consumed;
+          if (std::memcmp(record, "D2SF", 4) != 0) {
+            BOOST_LOG(error) << "Invalid D2S Moonlight frame marker";
+            shutdown_event->raise(true);
+            return -1;
+          }
+          const auto frame_index = read_u64(record + 4);
+          const auto capture_ns = read_u64(record + 12);
+          const auto flags = read_u32(record + 20);
+          const auto payload_size = read_u32(record + 24);
+          if (payload_size == 0 || payload_size > MAX_ACCESS_UNIT_SIZE) {
+            BOOST_LOG(error) << "Invalid D2S Moonlight access-unit size: "sv << payload_size;
+            shutdown_event->raise(true);
+            return -1;
+          }
+          const auto record_size = HEADER_SIZE + static_cast<std::size_t>(payload_size);
+          if (pending.size() - consumed < record_size) {
+            break;
+          }
+          std::vector<uint8_t> access_unit(payload_size);
+          std::memcpy(access_unit.data(), record + HEADER_SIZE, payload_size);
+          consumed += record_size;
+
+          auto packet = std::make_unique<packet_raw_generic>(
+            std::move(access_unit),
+            static_cast<int64_t>(frame_index),
+            (flags & 1U) != 0
+          );
+          packet->channel_data = channel_data;
+          packet->frame_timestamp = std::chrono::steady_clock::time_point {
+            std::chrono::nanoseconds {static_cast<int64_t>(capture_ns)}
+          };
+          packets->raise(std::move(packet));
+        }
+        if (consumed != 0) {
+          pending.erase(pending.begin(), pending.begin() + consumed);
+        }
+      }
+
+      shutdown_event->raise(true);
+      return 0;
+    } catch (const std::exception &exception) {
+      BOOST_LOG(error) << "D2S Moonlight bridge failed: "sv << exception.what();
+      shutdown_event->raise(true);
+      return -1;
+    }
+  }
