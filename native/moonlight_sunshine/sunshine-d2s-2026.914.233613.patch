+    const char *source_height_value = std::getenv("D2S_MOONLIGHT_SOURCE_HEIGHT");
+    const char *source_left_value = std::getenv("D2S_MOONLIGHT_SOURCE_LEFT");
+    const char *source_top_value = std::getenv("D2S_MOONLIGHT_SOURCE_TOP");
+    const char *desktop_width_value = std::getenv("D2S_MOONLIGHT_DESKTOP_WIDTH");
+    const char *desktop_height_value = std::getenv("D2S_MOONLIGHT_DESKTOP_HEIGHT");
+    if (!port_value || !token || !source_width_value || !source_height_value ||
+        !source_left_value || !source_top_value || !desktop_width_value || !desktop_height_value) {
+      BOOST_LOG(error) << "Moonlight bridge environment is incomplete";
+      shutdown_event->raise(true);
+      return -1;
+    }
+
+    auto parse_positive = [](const char *value, int &result) {
+      const char *end = value + std::strlen(value);
+      auto parsed = std::from_chars(value, end, result);
+      return parsed.ec == std::errc {} && parsed.ptr == end && result > 0;
+    };
+    int port = 0;
+    int source_width = 0;
+    int source_height = 0;
+    int source_left = 0;
+    int source_top = 0;
+    int desktop_width = 0;
+    int desktop_height = 0;
+    // Multi-monitor desktop coordinates can have negative left/top offsets.
+    auto parse_offset = [](const char *value, int &result) {
+      const char *end = value + std::strlen(value);
+      auto parsed = std::from_chars(value, end, result);
+      return parsed.ec == std::errc {} && parsed.ptr == end;
+    };
+    if (!parse_positive(port_value, port) || port > 65535 ||
+        !parse_positive(source_width_value, source_width) ||
+        !parse_positive(source_height_value, source_height) ||
+        !parse_offset(source_left_value, source_left) ||
+        !parse_offset(source_top_value, source_top) ||
+        !parse_positive(desktop_width_value, desktop_width) ||
+        !parse_positive(desktop_height_value, desktop_height)) {
+      BOOST_LOG(error) << "Moonlight bridge dimensions or port are invalid";
+      shutdown_event->raise(true);
+      return -1;
+    }
+    if (source_width > desktop_width || source_height > desktop_height) {
