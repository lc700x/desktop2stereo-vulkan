+  }
+  EXPECT_FLOAT_EQ(port.map_stereo_input(0, 0).second, 335);
+  EXPECT_FLOAT_EQ(port.map_stereo_input(1920, 1080).second, 605);
+  EXPECT_FLOAT_EQ(port.map_stereo_input(960, 540).second, 335);
+}
+
