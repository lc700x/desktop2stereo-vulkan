+  /**
+   * @brief Merge duplicate records for the same canonical client certificate.
+   *
+   * Duplicate records can make an otherwise paired certificate appear ambiguous
+   * during TLS authorization. A disabled duplicate keeps the merged identity
+   * disabled so this repair never overrides a user's disable action.
+   *
+   * @param client Pairing state to normalize.
+   * @return Number of duplicate records removed from the in-memory state.
+   */
+  std::size_t deduplicate_client_certificates(client_t &client) {
+    std::vector<named_cert_t> unique;
+    unique.reserve(client.named_devices.size());
+
+    for (auto &named_cert : client.named_devices) {
+      auto existing = std::find_if(
+        unique.begin(),
+        unique.end(),
+        [&](const named_cert_t &candidate) {
+          return candidate.cert == named_cert.cert;
+        }
+      );
+      if (existing == unique.end()) {
+        unique.emplace_back(std::move(named_cert));
+        continue;
+      }
+
+      existing->enabled = existing->enabled && named_cert.enabled;
+      if (existing->name.empty() && !named_cert.name.empty()) {
+        existing->name = std::move(named_cert.name);
+      }
+    }
+
+    const auto removed = client.named_devices.size() - unique.size();
+    if (removed > 0) {
+      client.named_devices = std::move(unique);
+    }
+    return removed;
+  }
