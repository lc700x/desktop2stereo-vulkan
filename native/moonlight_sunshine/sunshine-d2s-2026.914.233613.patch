     int env_logical_width;  ///< Width of the full capture environment after display scaling.
     int env_logical_height;  ///< Height of the full capture environment after display scaling.

+    int stream_width {};  ///< Encoded D2S canvas width, or zero for legacy input mapping.
+    int stream_height {};  ///< Encoded D2S canvas height, or zero for legacy input mapping.
+    std::array<std::array<float, 8>, 2> input_regions {};  ///< Per-eye viewport and capture crop bounds.
+
+    /**
+     * @brief Map an encoded-canvas point through its closest eye's actual image rectangle.
+     *
+     * Letterbox input clamps to the nearest visible image edge. Cover input uses
+     * the reported capture crop rather than the uncropped desktop dimensions.
+     *
+     * @param x Horizontal encoded-canvas coordinate.
+     * @param y Vertical encoded-canvas coordinate.
+     * @return Host-relative coordinates, including the capture origin and DPI scale.
+     */
+    std::pair<float, float> map_stereo_input(float x, float y) const {
+      const auto *selected = &input_regions[0];
+      float nearest = -1.0f;
+      for (const auto &region : input_regions) {
+        const float dx = x - std::clamp(x, region[0], region[2]);
+        const float dy = y - std::clamp(y, region[1], region[3]);
+        const float distance = dx * dx + dy * dy;
+        // Equal distances select the second eye at an SBS/TAB dividing line.
+        if (nearest < 0.0f || distance <= nearest) {
+          nearest = distance;
+          selected = &region;
+        }
+      }
+      const auto &r = *selected;
+      const float u = std::clamp((x - r[0]) / (r[2] - r[0]), 0.0f, 1.0f);
+      const float v = std::clamp((y - r[1]) / (r[3] - r[1]), 0.0f, 1.0f);
+      return {
+        offset_x + (r[4] + u * (r[6] - r[4])) / scalar_tpcoords,
+        offset_y + (r[5] + v * (r[7] - r[5])) / scalar_tpcoords
+      };
+    }
+
     /**
      * @brief Check whether the touch-port bounds are initialized.
      */
