#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RgbBuffer {
    float rgb[];
};

layout(set = 0, binding = 1, std430) readonly buffer DepthBuffer {
    float depth[];
};

layout(set = 0, binding = 2, std430) writeonly buffer LeftBuffer {
    float left_eye[];
};

layout(set = 0, binding = 3, std430) writeonly buffer RightBuffer {
    float right_eye[];
};

layout(set = 0, binding = 4, std430) writeonly buffer MaskBuffer {
    float occlusion_mask[];
};

layout(push_constant) uniform StereoParams {
    uint width;
    uint height;
    float depth_strength;
    float max_disparity_px;
    float convergence;
    float edge_threshold;
    float fill_strength;
    uint fill_radius;
    uint mask_feather_radius;
    uint symmetric;
    uint hole_fill_mode;
} params;

const uint HOLE_FILL_BALANCED = 0u;
const uint HOLE_FILL_QUALITY = 1u;
const uint HOLE_FILL_NONE = 2u;

uint pixel_count() {
    return params.width * params.height;
}

int clamp_x(int x) {
    return clamp(x, 0, int(params.width) - 1);
}

int clamp_y(int y) {
    return clamp(y, 0, int(params.height) - 1);
}

uint pixel_index(int x, int y) {
    return uint(clamp_y(y)) * params.width + uint(clamp_x(x));
}

float depth_at(int x, int y) {
    return clamp(depth[pixel_index(x, y)], 0.0, 1.0);
}

float shift_at(int x, int y) {
    float response = depth_at(x, y) - params.convergence;
    return -response * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
}

float max_shift_magnitude() {
    float scale = max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
    return max(max(abs(params.convergence * scale), abs((1.0 - params.convergence) * scale)), 1.0e-6);
}

float clamp_coordinate(float coordinate, float extent) {
    return clamp(coordinate, 0.0, max(extent - 1.0, 0.0));
}

vec3 rgb_at(uint pixel) {
    uint plane = pixel_count();
    return vec3(
        rgb[pixel],
        rgb[plane + pixel],
        rgb[2 * plane + pixel]
    );
}

vec3 sample_rgb(float x, float y) {
    float clamped_x = clamp_coordinate(x, float(params.width));
    float clamped_y = clamp_coordinate(y, float(params.height));
    int x0 = int(floor(clamped_x));
    int y0 = int(floor(clamped_y));
    int x1 = min(x0 + 1, int(params.width) - 1);
    int y1 = min(y0 + 1, int(params.height) - 1);
    float tx = clamped_x - float(x0);
    float ty = clamped_y - float(y0);
    vec3 top = mix(rgb_at(pixel_index(x0, y0)), rgb_at(pixel_index(x1, y0)), tx);
    vec3 bottom = mix(rgb_at(pixel_index(x0, y1)), rgb_at(pixel_index(x1, y1)), tx);
    return mix(top, bottom, ty);
}

// Keep bilinear RGB sampling from averaging the two sides of a depth edge.
// This is the fused-pass equivalent of the layered DIBR visibility resolve:
// only taps belonging to the source pixel's depth class contribute to the
// displaced color.  Flat regions take the regular bilinear path.
vec3 sample_rgb_depth_class(float x, float y, float class_depth) {
    vec2 point = clamp(vec2(x, y), vec2(0.0),
                       vec2(float(params.width - 1u), float(params.height - 1u)));
    int x0 = int(floor(point.x));
    int y0 = int(floor(point.y));
    int x1 = min(x0 + 1, int(params.width) - 1);
    int y1 = min(y0 + 1, int(params.height) - 1);
    float tx = point.x - float(x0);
    float ty = point.y - float(y0);
    float w00 = (1.0 - tx) * (1.0 - ty);
    float w10 = tx * (1.0 - ty);
    float w01 = (1.0 - tx) * ty;
    float w11 = tx * ty;
    vec3 total = vec3(0.0);
    float weight = 0.0;
    float d = depth_at(x0, y0);
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += rgb_at(pixel_index(x0, y0)) * w00;
        weight += w00;
    }
    d = depth_at(x1, y0);
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += rgb_at(pixel_index(x1, y0)) * w10;
        weight += w10;
    }
    d = depth_at(x0, y1);
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += rgb_at(pixel_index(x0, y1)) * w01;
        weight += w01;
    }
    d = depth_at(x1, y1);
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += rgb_at(pixel_index(x1, y1)) * w11;
        weight += w11;
    }
    return weight > 1.0e-6 ? total / weight : sample_rgb(x, y);
}

vec3 warp_at(int x, int y, float eye_sign) {
    float depth_value = depth_at(x, y);
    return sample_rgb_depth_class(
        float(x) + shift_at(x, y) * eye_sign, float(y), depth_value
    );
}

float edge_at(int x, int y) {
    int right_x = min(x + 1, int(params.width) - 1);
    int down_y = min(y + 1, int(params.height) - 1);
    float center_depth = depth_at(x, y);
    float depth_edge = abs(depth_at(right_x, y) - center_depth)
        + abs(depth_at(x, down_y) - center_depth);
    float shift_edge = abs(abs(shift_at(right_x, y)) - abs(shift_at(x, y)))
        + abs(abs(shift_at(x, down_y)) - abs(shift_at(x, y)));
    return (depth_edge > params.edge_threshold || shift_edge / max_shift_magnitude() > 0.05)
        ? 1.0
        : 0.0;
}

float dilated_occlusion_at(int x, int y) {
    float found = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            found = max(found, edge_at(x + dx, y + dy));
        }
    }
    return found;
}

float feathered_mask_at(int x, int y) {
    int radius = min(int(params.mask_feather_radius), 3);
    if (radius <= 0) {
        return dilated_occlusion_at(x, y);
    }
    float total = 0.0;
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                int sample_x = x + dx;
                int sample_y = y + dy;
                if (params.hole_fill_mode == HOLE_FILL_BALANCED
                        || (sample_x >= 0 && sample_x < int(params.width)
                            && sample_y >= 0 && sample_y < int(params.height))) {
                    total += dilated_occlusion_at(sample_x, sample_y);
                }
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

vec3 box_average(int x, int y, float eye_sign) {
    int radius = min(int(params.fill_radius), 3);
    vec3 total = vec3(0.0);
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                int sample_x = x + dx;
                int sample_y = y + dy;
                if (sample_x >= 0 && sample_x < int(params.width)
                        && sample_y >= 0 && sample_y < int(params.height)) {
                    total += warp_at(sample_x, sample_y, eye_sign);
                }
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

float mean_luma(vec3 color) {
    return (color.r + color.g + color.b) / 3.0;
}

vec3 fill_eye(int x, int y, float eye_sign, float mask) {
    vec3 original = warp_at(x, y, eye_sign);
    if (params.hole_fill_mode == HOLE_FILL_NONE
            || mask <= 1.0e-5 || params.fill_strength <= 1.0e-5) return original;
    vec3 blurred = box_average(x, y, eye_sign);
    if (params.hole_fill_mode == HOLE_FILL_BALANCED) {
        return mix(original, blurred, clamp(mask * params.fill_strength, 0.0, 1.0));
    }
    float left_depth = depth_at(x - 1, y);
    float right_depth = depth_at(x + 1, y);
    float left_shift = shift_at(x - 1, y);
    float right_shift = shift_at(x + 1, y);
    bool reliable = abs(right_depth - left_depth) > params.edge_threshold
        || abs(right_shift - left_shift) > 0.05;
    int direction = right_depth < left_depth ? 1 : -1;
    int radius = clamp(int(params.fill_radius), 1, 3);
    vec3 directional = vec3(0.0);
    for (int step = 1; step <= 3; ++step) {
        if (step <= radius) {
            directional += warp_at(clamp_x(x + direction * step), y, eye_sign);
        }
    }
    directional /= float(radius);
    vec3 content_aware = reliable ? directional * 0.75 + blurred * 0.25 : blurred;
    float current_luma = mean_luma(original);
    float rgb_edge_x = x > 0
        ? abs(current_luma - mean_luma(warp_at(x - 1, y, eye_sign))) : 0.0;
    float rgb_edge_y = y > 0
        ? abs(current_luma - mean_luma(warp_at(x, y - 1, eye_sign))) : 0.0;
    float protection = clamp((max(rgb_edge_x, rgb_edge_y) - 0.20) / 0.30, 0.0, 1.0);
    float current_depth = depth_at(x, y);
    float depth_edge_x = x > 0 ? abs(current_depth - depth_at(x - 1, y)) : 0.0;
    float depth_edge_y = y > 0 ? abs(current_depth - depth_at(x, y - 1)) : 0.0;
    float depth_protection = clamp((max(depth_edge_x, depth_edge_y) - 0.04) / 0.12, 0.0, 1.0) * 0.5;
    protection = max(protection, depth_protection);
    float blend = clamp(mask * params.fill_strength * (1.0 - protection * 0.70), 0.0, 1.0);
    return mix(original, content_aware, blend);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= params.width || y >= params.height) {
        return;
    }
    int ix = int(x);
    int iy = int(y);
    bool fill_enabled = params.hole_fill_mode != HOLE_FILL_NONE && params.fill_strength > 1.0e-5;
    float mask = fill_enabled ? dilated_occlusion_at(ix, iy) : 0.0;
    float fill_mask = fill_enabled ? feathered_mask_at(ix, iy) : 0.0;
    uint pixel = pixel_index(ix, iy);
    uint plane = pixel_count();
    vec3 left = fill_eye(ix, iy, 1.0, fill_mask);
    float right_sign = params.symmetric != 0u ? -1.0 : -0.9;
    vec3 right = fill_eye(ix, iy, right_sign, fill_mask);
    left_eye[pixel] = left.r;
    left_eye[plane + pixel] = left.g;
    left_eye[2 * plane + pixel] = left.b;
    right_eye[pixel] = right.r;
    right_eye[plane + pixel] = right.g;
    right_eye[2 * plane + pixel] = right.b;
    occlusion_mask[pixel] = mask;
}
