#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RgbBuffer {
    float rgb[];
};

layout(set = 0, binding = 1, std430) readonly buffer DepthBuffer {
    float depth[];
};

layout(set = 0, binding = 2, std430) writeonly buffer LeftBuffer {
    float left_eye[];
};

layout(set = 0, binding = 3, std430) writeonly buffer RightBuffer {
    float right_eye[];
};

layout(set = 0, binding = 4, std430) writeonly buffer MaskBuffer {
    float occlusion_mask[];
};

layout(push_constant) uniform LayeredStereoParams {
    uint width;
    uint height;
    float depth_strength;
    float max_disparity_px;
    float convergence;
    float edge_threshold;
    float fill_strength;
    uint fill_radius;
    uint mask_feather_radius;
    uint symmetric;
    uint layers;
    float softness;
    float foreground_scale;
    float midground_scale;
    float background_scale;
    uint edge_dilation;
    uint screen_edge_suppression;
    uint hole_fill_mode;
    uint occlusion_enabled;
    uint edge_aa_enabled;
} params;

const uint HOLE_FILL_BALANCED = 0u;
const uint HOLE_FILL_QUALITY = 1u;
const uint HOLE_FILL_NONE = 2u;

uint pixel_count() {
    return params.width * params.height;
}

int clamp_x(int x) {
    return clamp(x, 0, int(params.width) - 1);
}

int clamp_y(int y) {
    return clamp(y, 0, int(params.height) - 1);
}

uint pixel_index(int x, int y) {
    return uint(clamp_y(y)) * params.width + uint(clamp_x(x));
}

float depth_at(int x, int y) {
    return clamp(depth[pixel_index(x, y)], 0.0, 1.0);
}

float sampled_depth(float x, float y) {
    float sx = clamp(x, 0.0, float(params.width - 1u));
    float sy = clamp(y, 0.0, float(params.height - 1u));
    ivec2 p0 = ivec2(floor(vec2(sx, sy)));
    ivec2 p1 = min(p0 + ivec2(1), ivec2(params.width - 1u, params.height - 1u));
    vec2 f = fract(vec2(sx, sy));
    float a = mix(depth_at(p0.x, p0.y), depth_at(p1.x, p0.y), f.x);
    float b = mix(depth_at(p0.x, p1.y), depth_at(p1.x, p1.y), f.x);
    return mix(a, b, f.y);
}

float nearest_sampled_depth(float x, float y) {
    vec2 point = clamp(vec2(x, y), vec2(0.0),
                       vec2(float(params.width - 1u), float(params.height - 1u)));
    int x0 = int(floor(point.x));
    int x1 = min(x0 + 1, int(params.width - 1u));
    int iy = int(floor(point.y + 0.5));
    return max(depth_at(x0, iy), depth_at(x1, iy));
}

float layered_depth_scale(float value) {
    float normalized = clamp(value, 0.0, 1.0);
    float background_weight = clamp((0.5 - normalized) * 2.0, 0.0, 1.0);
    float foreground_weight = clamp((normalized - 0.5) * 2.0, 0.0, 1.0);
    float midground_weight = clamp(1.0 - background_weight - foreground_weight, 0.0, 1.0);
    return background_weight * max(params.background_scale, 0.0)
        + midground_weight * max(params.midground_scale, 0.0)
        + foreground_weight * max(params.foreground_scale, 0.0);
}

float base_shift_at(int x, int y) {
    float response = depth_at(x, y) - params.convergence;
    response *= layered_depth_scale(depth_at(x, y));
    return -response * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
}

float layer_weight(float value, uint layer_index) {
    uint count = clamp(params.layers, 1u, 4u);
    if (count == 1u) {
        return 1.0;
    }
    float center = float(layer_index) / float(count - 1u);
    float softness = max(params.softness, 1.0e-4);
    return exp(-((clamp(value, 0.0, 1.0) - center) * (clamp(value, 0.0, 1.0) - center)) / softness);
}

float layer_shift_scale(uint layer_index) {
    uint count = clamp(params.layers, 1u, 4u);
    return 0.75 + 0.25 * float(layer_index + 1u) / float(count);
}

float effective_layer_shift_scale(float value) {
    uint count = clamp(params.layers, 1u, 4u);
    if (count == 1u) return 1.0;
    if (count == 2u) {
        float normalized = clamp(value, 0.0, 1.0);
        float foreground_weight = 1.0 / (1.0 + exp((1.0 - 2.0 * normalized)
            / max(params.softness, 1.0e-4)));
        return 0.875 + 0.125 * foreground_weight;
    }
    float weighted_scale = 0.0;
    float total_weight = 0.0;
    for (uint layer_index = 0u; layer_index < 4u; ++layer_index) {
        if (layer_index >= count) break;
        float weight = layer_weight(value, layer_index);
        weighted_scale += weight * layer_shift_scale(layer_index);
        total_weight += weight;
    }
    return weighted_scale / max(total_weight, 1.0e-6);
}

float clamp_coordinate(float coordinate, float extent) {
    return clamp(coordinate, 0.0, max(extent - 1.0, 0.0));
}

vec3 rgb_at(uint pixel) {
    uint plane = pixel_count();
    return vec3(rgb[pixel], rgb[plane + pixel], rgb[2 * plane + pixel]);
}

vec3 sample_rgb(float x, float y) {
    float clamped_x = clamp_coordinate(x, float(params.width));
    float clamped_y = clamp_coordinate(y, float(params.height));
    int x0 = int(floor(clamped_x));
    int y0 = int(floor(clamped_y));
    int x1 = min(x0 + 1, int(params.width) - 1);
    int y1 = min(y0 + 1, int(params.height) - 1);
    float tx = clamped_x - float(x0);
    float ty = clamped_y - float(y0);
    vec3 top = mix(rgb_at(pixel_index(x0, y0)), rgb_at(pixel_index(x1, y0)), tx);
    vec3 bottom = mix(rgb_at(pixel_index(x0, y1)), rgb_at(pixel_index(x1, y1)), tx);
    return mix(top, bottom, ty);
}

float forward_shift(float value) {
    return -(value - params.convergence) * layered_depth_scale(value)
        * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5
        * effective_layer_shift_scale(value);
}

int dibr_search_radius() {
    float scale = max(max(params.foreground_scale, params.midground_scale),
                      max(params.background_scale, 1.0));
    float span = max(abs(params.convergence), abs(1.0 - params.convergence));
    float bound = span * max(params.depth_strength, 0.0)
        * params.max_disparity_px * 0.5 * scale;
    return min(int(ceil(bound)) + 1, int(params.width));
}

vec3 sample_rgb_depth_class(float x, float y, float class_depth) {
    float sx = clamp_coordinate(x, float(params.width));
    float sy = clamp_coordinate(y, float(params.height));
    int x0 = int(floor(sx));
    int y0 = int(floor(sy));
    int x1 = min(x0 + 1, int(params.width) - 1);
    int y1 = min(y0 + 1, int(params.height) - 1);
    float fx = sx - float(x0);
    float fy = sy - float(y0);
    float w00 = (1.0 - fx) * (1.0 - fy);
    float w10 = fx * (1.0 - fy);
    float w01 = (1.0 - fx) * fy;
    float w11 = fx * fy;
    vec3 total = vec3(0.0);
    float weight = 0.0;
    float d = sampled_depth(float(x0), float(y0));
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += sample_rgb(float(x0), float(y0)) * w00; weight += w00;
    }
    d = sampled_depth(float(x1), float(y0));
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += sample_rgb(float(x1), float(y0)) * w10; weight += w10;
    }
    d = sampled_depth(float(x0), float(y1));
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += sample_rgb(float(x0), float(y1)) * w01; weight += w01;
    }
    d = sampled_depth(float(x1), float(y1));
    if (abs(d - class_depth) <= params.edge_threshold) {
        total += sample_rgb(float(x1), float(y1)) * w11; weight += w11;
    }
    return weight > 1.0e-6 ? total / weight : sample_rgb(x, y);
}

vec3 dibr_gather_at(float target_x, float target_y, float eye_sign) {
    int radius = dibr_search_radius();
    // Conservative depth 0..1 projection bounds, padded for bilinear splats.
    float maximum_scale = max(max(params.foreground_scale, params.midground_scale),
                              max(params.background_scale, 1.0));
    float disparity_bound = max(params.depth_strength, 0.0)
        * params.max_disparity_px * 0.5 * maximum_scale;
    float at_zero = target_x + params.convergence * disparity_bound * eye_sign;
    float at_one = target_x - (1.0 - params.convergence) * disparity_bound * eye_sign;
    float search_min = max(min(at_zero, at_one) - 1.0,
                           target_x - float(radius));
    float search_max = min(max(at_zero, at_one) + 1.0,
                           target_x + float(radius));
    // Keep the source lattice fixed at source-pixel centers while the target
    // is subpixel sampled. target_x + integer offsets slide the source grid
    // with each AA tap and makes silhouettes shimmer as the target moves.
    int first_source_x = int(ceil(search_min));
    int last_source_x = int(floor(search_max));
    float best_depth = -1.0;
    float best_coverage = 0.0;
    float best_x = target_x;
    float left_error = 1.0e6;
    float right_error = 1.0e6;
    float left_depth = -1.0;
    float right_depth = -1.0;
    float left_x = target_x;
    float right_x = target_x;
    for (int source_ix = first_source_x; source_ix <= last_source_x; ++source_ix) {
        float source_x = float(source_ix);
        if (source_x >= 0.0 && source_x < float(params.width)) {
            float value = sampled_depth(source_x, target_y);
            float error = source_x - forward_shift(value) * eye_sign - target_x;
            float coverage = max(0.0, 1.0 - abs(error));
            if (coverage > 0.0 && (value > best_depth ||
                (value == best_depth && coverage > best_coverage))) {
                best_depth = value;
                best_coverage = coverage;
                best_x = source_x;
            }
            if (error <= 0.0 && abs(error) < left_error) {
                left_error = abs(error); left_depth = value; left_x = source_x;
            }
            if (error >= 0.0 && error < right_error) {
                right_error = error; right_depth = value; right_x = source_x;
            }
        }
    }
    if (left_error >= 1.0e5) {
        left_error = right_error; left_depth = right_depth; left_x = right_x;
    }
    if (right_error >= 1.0e5) {
        right_error = left_error; right_depth = left_depth; right_x = left_x;
    }
    if (best_depth < 0.0) {
        return left_depth <= right_depth
            ? sample_rgb(left_x, target_y) : sample_rgb(right_x, target_y);
    }

    vec3 foreground = vec3(0.0);
    float foreground_coverage = 0.0;
    for (int offset = -1; offset <= 1; ++offset) {
        float source_x = best_x + float(offset);
        if (source_x >= 0.0 && source_x < float(params.width)) {
            float value = sampled_depth(source_x, target_y);
            if (value >= best_depth - params.edge_threshold) {
                float error = source_x - forward_shift(value) * eye_sign - target_x;
                float coverage = max(0.0, 1.0 - abs(error));
                if (coverage > 0.0) {
                    foreground += sample_rgb_depth_class(source_x, target_y, best_depth) * coverage;
                    foreground_coverage += coverage;
                }
            }
        }
    }
    foreground /= max(foreground_coverage, 1.0e-6);
    bool has_background = min(left_depth, right_depth)
        < best_depth - params.edge_threshold;
    if (!has_background) return foreground;
    vec3 background = left_depth <= right_depth
        ? sample_rgb_depth_class(left_x, target_y, left_depth)
        : sample_rgb_depth_class(right_x, target_y, right_depth);
    return mix(background, foreground, clamp(foreground_coverage, 0.0, 1.0));
}

vec3 dibr_warp_at(float target_x, float target_y, float eye_sign) {
    float target_depth = sampled_depth(target_x, target_y);
    float target_shift = -(target_depth - params.convergence) * layered_depth_scale(target_depth)
        * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5
        * effective_layer_shift_scale(target_depth);
    float source_x = clamp(target_x + target_shift * eye_sign, 0.0,
                           float(params.width - 1u));
    float source_depth = sampled_depth(source_x, target_y);
    float source_shift = -(source_depth - params.convergence) * layered_depth_scale(source_depth)
        * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5
        * effective_layer_shift_scale(source_depth);
    float refined_x = clamp(target_x + source_shift * eye_sign, 0.0,
                            float(params.width - 1u));
    float source_residual = abs(refined_x - source_x);
    bool foreground_candidate = false;
    // No depth can occlude a sample already within the visibility threshold of 1.
    if (source_depth < 1.0 - params.edge_threshold) {
        float front_shift = -(1.0 - params.convergence) * max(params.foreground_scale, 0.0)
            * max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
        float front_x = clamp(target_x + front_shift * eye_sign, 0.0,
                              float(params.width - 1u));
        foreground_candidate = nearest_sampled_depth(front_x, target_y)
            > source_depth + params.edge_threshold;
    }

    bool source_depth_edge = abs(source_depth - target_depth) > params.edge_threshold;
    if (source_depth_edge || source_residual > 0.5 || foreground_candidate) {
        return dibr_gather_at(target_x, target_y, eye_sign);
    }
    return sample_rgb(refined_x, target_y);
}

vec3 layered_warp_at(int x, int y, float eye_sign) {
    return dibr_warp_at(float(x), float(y), eye_sign);
}

float max_shift_magnitude() {
    float scale = max(params.depth_strength, 0.0) * params.max_disparity_px * 0.5;
    return max(max(abs(params.convergence * scale), abs((1.0 - params.convergence) * scale)), 1.0e-6);
}

float edge_at(int x, int y) {
    int right_x = min(x + 1, int(params.width) - 1);
    int down_y = min(y + 1, int(params.height) - 1);
    float center_depth = depth_at(x, y);
    float depth_edge = abs(depth_at(right_x, y) - center_depth)
        + abs(depth_at(x, down_y) - center_depth);
    float shift_edge = abs(abs(base_shift_at(right_x, y)) - abs(base_shift_at(x, y)))
        + abs(abs(base_shift_at(x, down_y)) - abs(base_shift_at(x, y)));
    return (depth_edge > params.edge_threshold || shift_edge / max_shift_magnitude() > 0.05)
        ? 1.0
        : 0.0;
}

vec3 layered_color_subpixel(float x, float y, float eye_sign) {
    return dibr_warp_at(x, y, eye_sign);
}

bool antialias_edge_at(int x, int y) {
    float center_depth = depth_at(x, y);
    float center_shift = base_shift_at(x, y);
    float depth_edge = max(
        max(abs(depth_at(x - 1, y) - center_depth), abs(depth_at(x + 1, y) - center_depth)),
        max(abs(depth_at(x, y - 1) - center_depth), abs(depth_at(x, y + 1) - center_depth))
    );
    float shift_edge = max(
        max(abs(base_shift_at(x - 1, y) - center_shift), abs(base_shift_at(x + 1, y) - center_shift)),
        max(abs(base_shift_at(x, y - 1) - center_shift), abs(base_shift_at(x, y + 1) - center_shift))
    );
    return depth_edge > clamp(params.edge_threshold, 0.01, 0.025)
        || shift_edge / max_shift_magnitude() > 0.025;
}

vec3 edge_adaptive_supersample(int x, int y, float eye_sign, vec3 center) {
    if (params.edge_aa_enabled == 0u || !antialias_edge_at(x, y)) {
        return center;
    }
    return (
        layered_color_subpixel(float(x) - 0.25, float(y) - 0.25, eye_sign)
        + layered_color_subpixel(float(x) + 0.25, float(y) - 0.25, eye_sign)
        + layered_color_subpixel(float(x) - 0.25, float(y) + 0.25, eye_sign)
        + layered_color_subpixel(float(x) + 0.25, float(y) + 0.25, eye_sign)
    ) * 0.25;
}

float dilated_occlusion_at(int x, int y) {
    if (params.occlusion_enabled == 0u) {
        return 0.0;
    }
    int radius = min(int(params.edge_dilation), 3);
    float found = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                found = max(found, edge_at(x + dx, y + dy));
            }
        }
    }
    return found;
}

float feathered_mask_at(int x, int y) {
    int radius = min(int(params.mask_feather_radius), 3);
    if (radius <= 0) {
        return dilated_occlusion_at(x, y);
    }
    float total = 0.0;
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                int sample_x = x + dx;
                int sample_y = y + dy;
                if (sample_x >= 0 && sample_x < int(params.width)
                        && sample_y >= 0 && sample_y < int(params.height)) {
                    total += dilated_occlusion_at(sample_x, sample_y);
                }
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

vec3 box_average(int x, int y, float eye_sign) {
    int radius = min(int(params.fill_radius), 3);
    vec3 total = vec3(0.0);
    float count = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            if (abs(dx) <= radius && abs(dy) <= radius) {
                int sample_x = x + dx;
                int sample_y = y + dy;
                if (sample_x >= 0 && sample_x < int(params.width)
                        && sample_y >= 0 && sample_y < int(params.height)) {
                    total += layered_warp_at(sample_x, sample_y, eye_sign);
                }
                count += 1.0;
            }
        }
    }
    return total / max(count, 1.0);
}

float mean_luma(vec3 color) {
    return (color.r + color.g + color.b) / 3.0;
}

vec3 fill_eye(int x, int y, float eye_sign, float mask) {
    vec3 original = layered_warp_at(x, y, eye_sign);
    if (params.hole_fill_mode == HOLE_FILL_NONE
            || mask <= 1.0e-5 || params.fill_strength <= 1.0e-5) return original;
    vec3 blurred = box_average(x, y, eye_sign);
    if (params.hole_fill_mode == HOLE_FILL_BALANCED) {
        return mix(original, blurred, clamp(mask * params.fill_strength, 0.0, 1.0));
    }

    float left_depth = depth_at(x - 1, y);
    float right_depth = depth_at(x + 1, y);
    float left_shift = base_shift_at(x - 1, y);
    float right_shift = base_shift_at(x + 1, y);
    bool reliable = abs(right_depth - left_depth) > params.edge_threshold
        || abs(right_shift - left_shift) > 0.05;
    bool use_right = right_depth < left_depth;
    int direction = use_right ? 1 : -1;
    int radius = clamp(int(params.fill_radius), 1, 3);
    vec3 directional = vec3(0.0);
    for (int step = 1; step <= 3; ++step) {
        if (step <= radius) {
            directional += layered_warp_at(clamp_x(x + direction * step), y, eye_sign);
        }
    }
    directional /= float(radius);
    vec3 content_aware = reliable ? directional * 0.75 + blurred * 0.25 : blurred;
    float current_luma = mean_luma(original);
    float rgb_edge_x = x > 0
        ? abs(current_luma - mean_luma(layered_warp_at(x - 1, y, eye_sign))) : 0.0;
    float rgb_edge_y = y > 0
        ? abs(current_luma - mean_luma(layered_warp_at(x, y - 1, eye_sign))) : 0.0;
    float protection = clamp((max(rgb_edge_x, rgb_edge_y) - 0.20) / 0.30, 0.0, 1.0);
    float current_depth = depth_at(x, y);
    float depth_edge_x = x > 0 ? abs(current_depth - depth_at(x - 1, y)) : 0.0;
    float depth_edge_y = y > 0 ? abs(current_depth - depth_at(x, y - 1)) : 0.0;
    float depth_protection = clamp((max(depth_edge_x, depth_edge_y) - 0.04) / 0.12, 0.0, 1.0) * 0.5;
    protection = max(protection, depth_protection);
    float blend = clamp(mask * params.fill_strength * (1.0 - protection * 0.70), 0.0, 1.0);
    return mix(original, content_aware, blend);
}

bool screen_edge_suppressed(int x, int y) {
    int border = int(params.screen_edge_suppression);
    return border > 0 && (x < border || y < border || x >= int(params.width) - border || y >= int(params.height) - border);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= params.width || y >= params.height) {
        return;
    }
    int ix = int(x);
    int iy = int(y);
    bool fill_enabled = params.hole_fill_mode != HOLE_FILL_NONE && params.fill_strength > 1.0e-5;
    float mask = (!fill_enabled || screen_edge_suppressed(ix, iy))
        ? 0.0 : dilated_occlusion_at(ix, iy);
    float fill_mask = (!fill_enabled || screen_edge_suppressed(ix, iy))
        ? 0.0 : feathered_mask_at(ix, iy);
    uint pixel = pixel_index(ix, iy);
    uint plane = pixel_count();
    vec3 left = edge_adaptive_supersample(
        ix, iy, 1.0, fill_eye(ix, iy, 1.0, fill_mask)
    );
    float right_sign = params.symmetric != 0u ? -1.0 : -0.9;
    vec3 right = edge_adaptive_supersample(
        ix, iy, right_sign, fill_eye(ix, iy, right_sign, fill_mask)
    );
    left_eye[pixel] = left.r;
    left_eye[plane + pixel] = left.g;
    left_eye[2 * plane + pixel] = left.b;
    right_eye[pixel] = right.r;
    right_eye[plane + pixel] = right.g;
    right_eye[2 * plane + pixel] = right.b;
    occlusion_mask[pixel] = mask;
}
