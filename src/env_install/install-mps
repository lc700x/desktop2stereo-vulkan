#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$SCRIPT_DIR"

echo "--- Desktop2Stereo Installer for Mac (Apple Silicon) ---"
echo "- Preparing a Python 3.11/3.12 environment"

find_supported_python() {
    local candidate
    for candidate in python3.12 python3.11; do
        if command -v "$candidate" >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON_CMD="$(find_supported_python || true)"
if [[ -z "$PYTHON_CMD" ]]; then
    if ! command -v brew >/dev/null 2>&1; then
        echo "Python 3.11 or 3.12 was not found and Homebrew is unavailable." >&2
        echo "Install Homebrew from https://brew.sh, then rerun this installer." >&2
        exit 1
    fi
    echo "- Installing Python 3.12 with Homebrew"
    brew install python@3.12
    PYTHON_CMD="$(find_supported_python || true)"
fi
if [[ -z "$PYTHON_CMD" ]]; then
    echo "Python is still unavailable after installation." >&2
    exit 1
fi
PYTHON_VERSION="$("$PYTHON_CMD" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
if [[ "$PYTHON_VERSION" != "3.11" && "$PYTHON_VERSION" != "3.12" ]]; then
    echo "$PYTHON_CMD resolved to Python $PYTHON_VERSION; Python 3.11 or 3.12 is required." >&2
    exit 1
fi
PYTHON_EXE="$(command -v "$PYTHON_CMD")"

VIRTUAL_ENV="$PROJECT_ROOT/python3"
STAGING_ENV="$PROJECT_ROOT/python3.staging.$$"
PIP_CACHE_DIR="${TMPDIR:-/tmp}/desktop2stereo-mps-pip-cache"
export PIP_RETRIES=10
export PIP_TIMEOUT=180
mkdir -p "$PIP_CACHE_DIR"

if [[ -e "$STAGING_ENV" ]]; then
    echo "A staging environment already exists: $STAGING_ENV" >&2
    echo "Remove that staging directory manually after checking it, then retry." >&2
    exit 1
fi

cleanup() {
    if [[ -d "$STAGING_ENV" ]]; then
        rm -rf "$STAGING_ENV"
    fi
}
trap cleanup EXIT

echo "- Creating replacement environment at $STAGING_ENV"
"$PYTHON_EXE" -m venv "$STAGING_ENV"
STAGING_PYTHON="$STAGING_ENV/bin/python"

echo "- Updating pip"
"$STAGING_PYTHON" -m pip install --upgrade pip \
    -r "$SCRIPT_DIR/requirements-pip-options.txt" \
    --cache-dir "$PIP_CACHE_DIR" --prefer-binary \
    --retries "$PIP_RETRIES" --timeout "$PIP_TIMEOUT"

echo "- Installing macOS MPS and CoreML requirements"
"$STAGING_PYTHON" -m pip install -r "$SCRIPT_DIR/requirements-mps.txt" \
    --cache-dir "$PIP_CACHE_DIR" --prefer-binary \
    --retries "$PIP_RETRIES" --timeout "$PIP_TIMEOUT"
"$STAGING_PYTHON" -m pip install -r "$SCRIPT_DIR/requirements.txt" \
    --cache-dir "$PIP_CACHE_DIR" --prefer-binary \
    --retries "$PIP_RETRIES" --timeout "$PIP_TIMEOUT"

verify_macos_runtime() {
    "$1" - <<'PY'
import coremltools
import torch

if not torch.backends.mps.is_available():
    raise SystemExit("PyTorch MPS is unavailable")
print(f"PyTorch MPS and CoreML are ready (torch {torch.__version__}, coremltools {coremltools.__version__})")
PY
}

echo "- Verifying PyTorch MPS and CoreML"
if ! verify_macos_runtime "$STAGING_PYTHON"; then
    echo "The replacement environment failed its MPS/CoreML check; the current environment was kept." >&2
    echo "Review the error above, then rerun src/env_install/install-mps." >&2
    exit 1
fi
if ! "$STAGING_PYTHON" -m pip check; then
    echo "The replacement environment has dependency conflicts; the current environment was kept." >&2
    exit 1
fi

echo "- Installing the Vulkan loader (MoltenVK)"
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew was not found. Install it from https://brew.sh, then rerun this installer." >&2
    exit 1
fi
if ! brew list --formula vulkan-loader >/dev/null 2>&1 || ! brew list --formula molten-vk >/dev/null 2>&1; then
    brew install molten-vk vulkan-loader
else
    echo "Vulkan loader already installed"
fi

BACKUP_ENV=""
if [[ -e "$VIRTUAL_ENV" ]]; then
    BACKUP_ENV="$VIRTUAL_ENV.backup.$(date +%Y%m%d%H%M%S)"
    if [[ -e "$BACKUP_ENV" ]]; then
        echo "Backup path already exists: $BACKUP_ENV" >&2
        exit 1
    fi
    mv "$VIRTUAL_ENV" "$BACKUP_ENV"
fi

if ! mv "$STAGING_ENV" "$VIRTUAL_ENV"; then
    if [[ -n "$BACKUP_ENV" && -e "$BACKUP_ENV" ]]; then
        mv "$BACKUP_ENV" "$VIRTUAL_ENV"
    fi
    echo "Could not activate the replacement environment; the previous environment was restored." >&2
    exit 1
fi

if ! verify_macos_runtime "$VIRTUAL_ENV/bin/python"; then
    FAILED_ENV="$VIRTUAL_ENV.failed.$(date +%Y%m%d%H%M%S)"
    mv "$VIRTUAL_ENV" "$FAILED_ENV"
    if [[ -n "$BACKUP_ENV" && -e "$BACKUP_ENV" ]]; then
        mv "$BACKUP_ENV" "$VIRTUAL_ENV"
    fi
    echo "The activated environment failed verification and was moved to $FAILED_ENV." >&2
    echo "The previous environment was restored when one was available." >&2
    exit 1
fi

chmod a+x "$PROJECT_ROOT/run_mac"
echo "Python environment deployed successfully."
if [[ -n "$BACKUP_ENV" ]]; then
    echo "Previous environment retained at: $BACKUP_ENV"
fi
if [[ -t 0 ]]; then
    read -r -p "You can close this terminal window to exit... " _
fi
